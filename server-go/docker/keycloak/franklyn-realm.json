{
  "realm": "franklyn",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "franklyn-admin"
      },
      {
        "name": "teacher"
      },
      {
        "name": "student"
      }
    ]
  },
  "clients": [
    {
      "clientId": "proctor",
      "name": "Proctor (frontend)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "server",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "distinguished_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "distinguished_name",
            "claim.name": "distinguished_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sentinel",
      "name": "Sentinel (desktop agent)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:*/callback",
        "http://localhost:*/callback"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "server",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "distinguished_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "distinguished_name",
            "claim.name": "distinguished_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "server",
      "name": "Franklyn server (go)",
      "enabled": true,
      "publicClient": false,
      "secret": "server-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "backend",
      "name": "Franklyn server (quarkus)",
      "enabled": true,
      "publicClient": false,
      "secret": "backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "teacher",
      "enabled": true,
      "emailVerified": true,
      "email": "teacher@franklyn.test",
      "firstName": "Tina",
      "lastName": "Teacher",
      "attributes": {
        "distinguished_name": [
          "CN=Tina Teacher,OU=Teachers,DC=htl-leonding,DC=ac,DC=at"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "teacher",
          "temporary": false
        }
      ],
      "realmRoles": [
        "teacher"
      ]
    },
    {
      "username": "student",
      "enabled": true,
      "emailVerified": true,
      "email": "student@franklyn.test",
      "firstName": "Stan",
      "lastName": "Student",
      "attributes": {
        "distinguished_name": [
          "CN=Stan Student,OU=Students,DC=htl-leonding,DC=ac,DC=at"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "student",
          "temporary": false
        }
      ],
      "realmRoles": [
        "student"
      ]
    },
    {
      "username": "franklyn-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@franklyn.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": {
        "distinguished_name": [
          "CN=Ada Admin,OU=Teachers,DC=htl-leonding,DC=ac,DC=at"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "teacher",
        "franklyn-admin"
      ]
    }
  ]
}
