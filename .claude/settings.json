{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "rm -f \"${TMPDIR:-/tmp}/franklyn-tests-poisoned\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/test-poison-guard.sh\"" }
        ]
      }
    ]
  }
}
