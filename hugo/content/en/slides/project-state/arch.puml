@startuml arch
scale 1.35
skinparam backgroundColor transparent
skinparam defaultFontColor #ECEFF4
skinparam ArrowColor #D8DEE9
skinparam DefaultBorderColor #4C566A
skinparam nodeBackgroundColor #3B4252
skinparam componentBackgroundColor #434C5E
skinparam componentStyle rectangle
skinparam databaseBackgroundColor #3B4252
skinparam cloudBackgroundColor #3B4252
skinparam cloudFontColor #ECEFF4

node "Student Device" {
    component "Sentinel\n(Rust, CLI + GUI)" as Sentinel
}

cloud "Franklyn Server\n(Quarkus, Java 21)" as Server

database "PostgreSQL\n+ Recordings" as DB

node "Teacher" {
    component "Proctor\n(Vue 3)" as Proctor
    component "Mobile\n(iOS)" as Mobile
}

Sentinel --> Server : Frames (WebSocket, protobuf)
Server --> DB : Sessions, Exams, Videos
Proctor --> Server : GraphQL + WebSocket
Mobile --> Server : GraphQL
@enduml
